# ---- Unity ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.mooserunner*/

# Asset meta files should NOT be ignored — Unity needs them
!/[Aa]ssets/**/*.meta

# Autogenerated
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.gradle/
ExportedObj/
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Auto-generated IDE project/solution files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Builds / packaging
*.apk
*.aab
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db

# Claude Code local (machine-specific permissions)
.claude/settings.local.json

# ---- MooseRunner (package-generated binaries + secrets + data; not source) ----
# The contents rather than the folder itself: git never descends into an ignored directory, so
# excluding /MooseRunner/ outright also disabled the .gitignore the package ships inside it (which
# excludes .env and daemon.json) and made it impossible to re-include anything.
/MooseRunner/*

# speedConfig.json is the exception: per-method test speeds are something a person decided, not
# something the package generated, and they are worth surviving a fresh clone.
!/MooseRunner/speedConfig.json
/Assets/MooseRunnerMultiplayTestData/
/Assets/MooseRunnerMultiplayTestData.meta


# Test-run screenshot artifacts (regenerated by the E2E)
/Screenshots/


# SessionRecorder output (large video files, regenerated by the E2E)
/.mooserunner/

# WebGL build output. Builds/ is already covered by the [Bb]uilds/ rule above; both are named here so
# the reason is on record. The ~21MB payload used to be committed to main on every deploy, which put
# 34 builds into history. It is published to the orphan gh-pages branch instead — Tools/publish-pages.sh.
# docs/ is the old name, kept ignored so a stale copy is never committed by accident.
/Builds/
/docs/


# Unity's performance-testing package writes these the first time the test runner starts. They are
# test-run metadata rather than source, but they land under Assets/Resources — so without this they
# get committed, and get built into the player.
/Assets/Resources/PerformanceTestRun*.json
/Assets/Resources/PerformanceTestRun*.json.meta
